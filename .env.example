# ------------------------------------------------------------------
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ------------------------------------------------------------------

# Database
DATABASE_URL="file:./dev.db"

# Full origin of your deployed site (used by NextAuth for cookie flags
# and redirects). Must include protocol. Use https:// in production.
NEXTAUTH_URL="http://localhost:3000"

# NextAuth session secret. MUST be a long random string.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=""

# Admin credentials
# Pick a username — do NOT use "admin"
ADMIN_USERNAME=""

# Preferred: set a bcrypt hash of the admin password.
# Generate one with the following Node one-liner (replace "yourpass"):
#   node -e "console.log(require('bcryptjs').hashSync('yourpass', 12))"
ADMIN_PASSWORD_HASH=""

# Optional fallback (plaintext). Only use locally.
# ADMIN_PASSWORD=""
