generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model MenuItem {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Float
  category    String
  pizzaType   String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LunchDay {
  id          Int      @id @default(autoincrement())
  weekNumber  Int
  year        Int
  dayOfWeek   String
  dishName    String
  description String
  price       Float
  updatedAt   DateTime @updatedAt
}

model WeeklySoup {
  id          Int      @id @default(autoincrement())
  weekNumber  Int
  year        Int
  name        String
  description String
  price       Float
}

model PageContent {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model GalleryImage {
  id        Int      @id @default(autoincrement())
  filename  String
  alt       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Booking {
  id              Int      @id @default(autoincrement())
  name            String
  phone           String
  email           String
  date            String
  time            String
  guests          Int
  specialRequests String?
  status          String   @default("pending")
  createdAt       DateTime @default(now())
}
